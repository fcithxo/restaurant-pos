
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restaurant POS</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f5f7;
      padding: 30px;
    }

    h1 {
      color: #174c3c;
    }

    .menu {
      background: white;
      padding: 20px;
      border-radius: 12px;
      max-width: 400px;
    }

    button {
      display: block;
      width: 100%;
      padding: 12px;
      margin: 10px 0;
      border: none;
      border-radius: 8px;
      background: #176b50;
      color: white;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <h1>Restaurant POS</h1>
  <p>Welcome to our restaurant!</p>

  <div class="menu">
    <h2>Food Menu</h2>
    <button onclick="order('Chicken', 150)">
      Chicken - ₱150
    </button>
    <button onclick="order('Burger', 120)">
      Burger - ₱120
    </button>
    <button onclick="order('Fries', 80)">
      Fries - ₱80
    </button>

    <h2>Current Order</h2>
    <ul id="cart"></ul>
    <h3>Total: ₱<span id="total">0</span></h3>
  </div>

  <script>
    let total = 0;

    function order(name, price) {
      const item = document.createElement('li');
      item.textContent = name + ' - ₱' + price;
      document.getElementById('cart').appendChild(item);

      total += price;
      document.getElementById('total').textContent = total;
    }
  </script>
</body>
</html>

